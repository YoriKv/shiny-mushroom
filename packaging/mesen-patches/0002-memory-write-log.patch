--- a/Core/Debugger/MemoryAccessCounter.cpp
+++ b/Core/Debugger/MemoryAccessCounter.cpp
@@ -51,7 +51,52 @@ void MemoryAccessCounter::ProcessMemoryWrite(AddressInfo& addressInfo, uint64_t
 		AddressCounters& counts = _counters[(int)addressInfo.Type][addressInfo.Address + i];
 		counts.WriteStamp = masterClock;
 		counts.WriteCounter++;
+		if(addressInfo.Type == _writeLogType) {
+			LogWrite((uint32_t)(addressInfo.Address + i), masterClock);
+		}
+	}
+}
+
+void MemoryAccessCounter::LogWrite(uint32_t address, uint64_t masterClock)
+{
+	if(address < _writeLogStart || address >= _writeLogEnd) {
+		return;
+	}
+	if(_writeLogCount >= _writeLog.size()) {
+		_writeLogOverflow = true;
+		return;
+	}
+	_writeLog[_writeLogCount].MasterClock = masterClock;
+	_writeLog[_writeLogCount].Address = address;
+	_writeLog[_writeLogCount].Padding = 0;
+	_writeLogCount++;
+}
+
+void MemoryAccessCounter::SetWriteLogRange(MemoryType memoryType, uint32_t offset, uint32_t length, uint32_t capacity)
+{
+	DebugBreakHelper helper(_debugger);
+	if(length == 0 || capacity == 0) {
+		_writeLogType = MemoryType::None;
+		_writeLogStart = 0;
+		_writeLogEnd = 0;
+		_writeLog.clear();
+	} else {
+		_writeLogType = memoryType;
+		_writeLogStart = offset;
+		_writeLogEnd = offset + length;
+		_writeLog.resize(capacity);
+	}
+	_writeLogCount = 0;
+	_writeLogOverflow = false;
+}
+
+uint32_t MemoryAccessCounter::GetWriteLog(WriteLogEntry entries[], uint32_t& overflow)
+{
+	overflow = _writeLogOverflow ? 1 : 0;
+	if(entries != nullptr && _writeLogCount > 0) {
+		memcpy(entries, _writeLog.data(), _writeLogCount * sizeof(WriteLogEntry));
 	}
+	return _writeLogCount;
 }
 
